    {
      "id": "C6",
      "capability": "Live progress while pages are written, then the guide is ready to study",
      "persona": "Dana watches the guide build",
      "kind": "happy",
      "viewports": [
        "desktop"
      ],
      "steps": [
        {
          "goto": "/new"
        },
        {
          "upload": {
            "testid": "file-input",
