  "scenarios": [
    {
      "id": "C1",
      "capability": "One click gives a complete sample guide: lesson, quiz and term cards, labelled as sample",
      "persona": "Dana, a maintenance lead, wants to see what her new techs would get before uploading anything",
      "kind": "happy",
      "steps": [
        {
          "goto": "/"
        },
        {
          "screenshot": "empty-library"
        },
        {
          "click": {
            "role": "button",
            "name": "Try the sample guide"
          }
        },
        {
          "expect_url": "/guides/[^/]+/read"
        },
        {
          "expect_visible": {
            "role": "heading",
            "name": "Parts and flow path"
          }
        },
        {
          "expect_visible": {
            "role": "heading",
            "name": "Check your understanding"
          }
        },
        {
          "expect_visible": {
            "role": "heading",
            "name": "Key terms"
          }
        },
        {
          "expect_visible": {
            "text": "Demo mode",
            "exact": false
          }
        },
        {
          "screenshot": "reader"
        }
      ]
    },
    {
      "id": "C2",
      "capability": "Upload a manual: the title is prefilled from the file and the build starts",
      "persona": "Dana uploads the Line 3 packaging machine manual (PDF)",
      "kind": "happy",
      "viewports": [
        "desktop"
      ],
      "steps": [
        {
          "goto": "/new"
        },
        {
          "upload": {
            "testid": "file-input",
            "files": [
              {
                "name": "line3-packaging-manual.pdf",
                "mime": "application/pdf",
                "text": "%PDF-1.7"
              }
            ]
          }
        },
        {
          "expect_visible": {
            "text": "line3-packaging-manual.pdf"
          }
        },
        {
          "expect_value": {
            "label": "Guide title",
            "value": "Line3 Packaging Manual"
          }
        },
        {
          "fill": {
            "label": "After this guide, a learner should be able to…",
            "value": "Start up, monitor and safely shut down Line 3, and fix its five most common faults"
          }
        },
        {
          "click": {
            "css": "label",
            "has_text": "Advanced"
          }
        },
        {
          "expect_count": {
            "css": "input[type=radio][value=deep]:checked",
            "count": 1
          }
        },
        {
          "screenshot": "upload-form"
        },
        {
          "click": {
            "role": "button",
            "name": "Build my guide"
          }
        },
        {
          "expect_visible": {
            "role": "heading",
            "name": "Reading your documents"
          }
        },
        {
          "screenshot": "reading"
        }
      ]
    },
    {
      "id": "C3",
      "capability": "Refuses bad input before anything is sent: unsupported file, no files, no title",
      "persona": "A trainer drags in a CSV export by mistake",
      "kind": "edge",
      "viewports": [
        "desktop"
      ],
      "steps": [
        {
          "goto": "/new"
        },
        {
          "click": {
            "role": "button",
            "name": "Build my guide"
          }
        },
        {
          "expect_visible": {
            "text": "Add at least one document."
          }
        },
        {
          "expect_visible": {
            "text": "Give the guide a title."
          }
        },
        {
          "upload": {
            "testid": "file-input",
            "files": [
              {
                "name": "data.csv",
                "mime": "text/csv",
                "text": "a,b"
              }
            ]
          }
        },
        {
          "expect_visible": {
            "text": "data.csv isn't a supported study format."
          }
        },
        {
          "click": {
            "role": "button",
            "name": "Build my guide"
          }
        },
        {
          "expect_url": "/new$"
        },
        {
          "screenshot": "refused"
        }
      ]
    },
    {
      "id": "C4",
      "capability": "Nothing is written until the learner approves the scope; study tabs stay locked",
      "persona": "Dana checks what the guide will cover before committing",
      "kind": "happy",
      "viewports": [
        "desktop"
      ],
      "steps": [
        {
          "goto": "/new"
        },
        {
          "upload": {
            "testid": "file-input",
            "files": [
              {
                "name": "pump-om-manual.pdf",
